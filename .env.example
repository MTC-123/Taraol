# otel-agent-kit / research-mesh example — copy to .env (git-ignored). Never commit keys.

# --- Kit runtime ---------------------------------------------------------------
# OTLP target (the SigNoz collector). Standard OTel var.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Opt-in LangSmith-style content capture. off = no prompt/output/tool text on spans.
OAK_CAPTURE_CONTENT=off
OAK_CONTENT_MAX_CHARS=12000

# --- LLM provider (example app) ------------------------------------------------
# fake (offline default) | gemini (needs GEMINI_API_KEY) | real (needs OAK_LLM_ENDPOINT+KEY)
OAK_LLM=fake
MESH_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OAK_LLM_ENDPOINT=
OAK_LLM_API_KEY=

# --- Web search tool (example app) ---------------------------------------------
# fake (offline default) | tavily (needs TAVILY_API_KEY)
OAK_SEARCH=fake
TAVILY_API_KEY=

# --- Example mesh behavior -----------------------------------------------------
# off | on | storm — storm drives the writer<->critic runaway loop for the demo.
MESH_LOOP_MODE=off

# --- Detection (example compose) ----------------------------------------------
OAK_ENFORCE=auto
# Persist SigNoz's JWT signing key so browser sessions survive restarts.
SIGNOZ_TOKENIZER_JWT_SECRET=replace-with-a-random-32-byte-secret
# Only needed if the watcher uses the SigNoz Query API instead of the ClickHouse fallback.
SIGNOZ_API_KEY=
SIGNOZ_URL=http://localhost:8080
SIGNOZ_MCP_URL=http://localhost:8003/mcp
